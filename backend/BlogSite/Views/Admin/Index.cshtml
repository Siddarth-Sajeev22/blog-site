@model IEnumerable<BlogSite.Models.BlogPost>

@{
    ViewData["Title"] = "Manage Posts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Manage Posts</h1>
    <a class="btn btn-primary" href="@Url.Action("Create")">Create New</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach(var post in Model)
    {
        <tr>
            <td>@post.Id</td>
            <td>@post.Title</td>
            <td>@post.CreatedAt.ToString("yyyy-MM-dd")</td>
            <td>
                <a class="btn btn-sm btn-secondary me-1" href="@Url.Action("Edit", new { id = post.Id })">Edit</a>
                <a class="btn btn-sm btn-info me-1" href="@Url.Action("Details", new { id = post.Id })">Details</a>
                <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", new { id = post.Id })">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
