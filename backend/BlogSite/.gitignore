_ReSharper*/
*.DotSettings.user

# Node/NPM (if you use frontend assets)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS and Windows junk files
.DS_Store
Thumbs.db

# Visual Studio and VS Code settings
.vs/
